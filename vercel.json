{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/check-v2-deploy.mjs && node scripts/check.mjs && node --test tests/*.test.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "functions": {
    "api/ai.js": {
      "maxDuration": 120,
      "includeFiles": "research/scenario-lab/{seeds.txt,mechanisms.json}"
    },
    "api/discovery.js": {
      "maxDuration": 60,
      "includeFiles": "research/scenario-lab/{seeds.txt,mechanisms.json}"
    },
    "api/session.js": {"includeFiles": "research/scenario-lab/{seeds.txt,mechanisms.json}"},
    "api/agents.js": {"includeFiles": "research/scenario-lab/{seeds.txt,mechanisms.json}"},
    "api/profile.js": {"includeFiles": "research/scenario-lab/{seeds.txt,mechanisms.json}"},
    "api/offers.js": {"includeFiles": "research/scenario-lab/{seeds.txt,mechanisms.json}"},
    "api/workspace.js": {"includeFiles": "research/scenario-lab/{seeds.txt,mechanisms.json}"},
    "api/channels.js": {"includeFiles": "research/scenario-lab/{seeds.txt,mechanisms.json}"},
    "api/buyer-requests.js": {"includeFiles": "research/scenario-lab/{seeds.txt,mechanisms.json}"},
    "api/agent-chat.js": {"includeFiles": "research/scenario-lab/{seeds.txt,mechanisms.json}"},
    "api/buyer-reviews.js": {"includeFiles": "research/scenario-lab/{seeds.txt,mechanisms.json}"}
  }
}
