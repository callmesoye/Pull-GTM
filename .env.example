# Existing Pull project. Use its publishable/anon key, never a service-role key.
SUPABASE_URL=https://cyakphnpljeesotbjerz.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_project_key

# Optional Google sign-in. Configure the Google provider in Supabase first.
# For local OAuth testing, change PULL_APP_URL to http://127.0.0.1:4173.
PULL_APP_URL=https://pull-gtm.vercel.app
GOOGLE_AUTH_ENABLED=false
# Generate a private random value of at least 32 characters before enabling Google.
# PULL_OAUTH_COOKIE_SECRET=

# Source-page search. Keys stay on the server; no provider account is created here.
# Exa is selected when its key is present, otherwise Serper, then Brave.
# An explicit provider selects only that key; failures never spend another key.
# Optional Exa free-quota adapter; not live-verified until the owner supplies a key.
# EXA_API_KEY=
# PULL_SEARCH_PROVIDER=exa
# SERPER_API_KEY=
# BRAVE_SEARCH_API_KEY=
# Serper free-plan default: plain queries, with source filters enforced on results.
# auto explicitly tries a source-restricted query and falls back once if rejected.
# Leave plain for the current free-only setup; no operator probe uses its budget.
PULL_SERPER_QUERY_MODE=plain
# Each search adaptively tries equivalent titles, source pages, and company evidence.
# Provider requests: 1 to 12; default 8, stopping at the requested count or 45 seconds.
# Each actual request claims one daily-budget unit (100 per owner / 500 project).
# A request limit is not a promise of that many prospects or provider credits.
PULL_SEARCH_MAX_QUERIES=8

# Direct Pull chat uses Vercel's OIDC token when available. Set false to disable it.
# Calls remain subject to the per-user and project daily database budgets.
# PULL_HOSTED_AI_ENABLED=false
# Outside Vercel, supply a private AI Gateway key on the server.
# AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.4-mini

# Optional local preview port; default is 4173.
# PORT=4173

# Edge Function only, configured in Supabase rather than this Vercel/local file:
# PULL_MCP_ALLOWED_ORIGINS=https://your-custom-domain.example
# Supabase injects SUPABASE_SECRET_KEYS or SUPABASE_SERVICE_ROLE_KEY there.

# Optional native delivery apps; separate from Supabase sign-in.
# Add only after the owner registers the exact callback and approves scopes.
PULL_GMAIL_CLIENT_ID=
PULL_GMAIL_CLIENT_SECRET=
PULL_X_CLIENT_ID=
PULL_X_CLIENT_SECRET=
PULL_LINKEDIN_CLIENT_ID=
PULL_LINKEDIN_CLIENT_SECRET=
# Optional dedicated encryption secret; otherwise uses PULL_OAUTH_COOKIE_SECRET.
# Provision its derived receipt-capability digest per docs/NATIVE-DELIVERY.md.
PULL_CHANNEL_SECRET=
